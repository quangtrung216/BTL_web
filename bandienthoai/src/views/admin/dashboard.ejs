<% const data = items || summary || item || {}; %>
<% const revenue = Number(data.totalRevenue || 0); %>
<% const chartRows = Array.isArray(revenueChart) ? revenueChart : []; %>
<% const maxChartRevenue = chartRows.reduce(function(max, row) { return Math.max(max, Number(row.value || 0)); }, 0); %>
<% const revenueGrowth = Number(data.revenueGrowthPercent || 0); %>
<% const orderGrowth = Number(data.orderGrowthPercent || 0); %>
<% const formatPercent = function(value) { return (value > 0 ? '+' : '') + value.toLocaleString('vi-VN') + '%'; }; %>
<% const topProductRows = Array.isArray(topProducts) ? topProducts : []; %>
<% const recentOrderRows = Array.isArray(recentOrders) ? recentOrders : []; %>
<% const formatMoney = function(value) { return Number(value || 0).toLocaleString('vi-VN') + ' đ'; }; %>
<% const statusMap = { pending: 'Chờ xác nhận', confirmed: 'Đã xác nhận', preparing: 'Đang pha chế', ready: 'Sẵn sàng', delivering: 'Đang giao', completed: 'Hoàn thành', cancelled: 'Đã hủy' }; %>

<section class='admin-dashboard'>
  <div class='admin-page-title'>
    <h1>Tổng quan</h1>
    <p>Theo dõi nhanh doanh thu, đơn hàng, sản phẩm và khách hàng.</p>
  </div>

  <div class='metric-grid'>
    <article class='metric-card'>
      <span class='metric-card__icon is-green'>VND</span>
      <small>Tổng doanh thu</small>
      <strong><%= revenue.toLocaleString('vi-VN') %> đ</strong>
      <em><%= formatPercent(revenueGrowth) %> so với hôm qua</em>
    </article>

    <article class='metric-card'>
      <span class='metric-card__icon is-peach'>OD</span>
      <small>Tổng đơn hàng</small>
      <strong><%= Number(data.totalOrders || 0).toLocaleString('vi-VN') %></strong>
      <em><%= formatPercent(orderGrowth) %> so với hôm qua</em>
    </article>

    <article class='metric-card'>
      <span class='metric-card__icon is-blue'>SP</span>
      <small>Sản phẩm</small>
      <strong><%= Number(data.totalProducts || 0).toLocaleString('vi-VN') %></strong>
      <em>+ 7.1% đang kinh doanh</em>
    </article>

    <article class='metric-card'>
      <span class='metric-card__icon is-brown'>KH</span>
      <small>Khách hàng</small>
      <strong><%= Number(data.totalUsers || 0).toLocaleString('vi-VN') %></strong>
      <em>+ 10.3% tài khoản hoạt động</em>
    </article>
  </div>

  <div class='dashboard-grid'>
    <section class='dashboard-panel revenue-panel'>
      <div class='panel-heading'>
        <div>
          <h2>Doanh thu</h2>
          <p>7 ngày gần nhất</p>
        </div>
        <a href='/admin/statistics'>Xem báo cáo</a>
      </div>
      <div class='bar-chart' aria-label='Biểu đồ doanh thu'>
        <% chartRows.forEach(function(row, index) { %>
          <%
            const chartValue = Number(row.value || 0);
            const chartHeight = maxChartRevenue > 0 ? Math.max(4, Math.round((chartValue / maxChartRevenue) * 100)) : 0;
            const chartMoney = chartValue.toLocaleString('vi-VN') + ' đ';
          %>
          <span style='--h:<%= chartHeight %>%; --i:<%= index %>' data-label='<%= row.displayLabel || row.label %>' data-value='<%= chartMoney %>' title='<%= (row.displayLabel || row.label) + ": " + chartMoney %>'></span>
        <% }) %>
      </div>
    </section>

    <section class='dashboard-panel'>
      <div class='panel-heading'>
        <h2>Sản phẩm bán chạy</h2>
        <a href='/admin/products'>Xem tất cả</a>
      </div>
      <ul class='top-products'>
        <% if (topProductRows.length) { %>
        <% topProductRows.forEach(function(product, index) { %>
          <li>
            <span><%= index + 1 %></span>
            <div>
              <strong><%= product.name || 'Sản phẩm #' + (product.id || '-') %></strong>
              <small>Đã bán: <%= Number(product.total_sold || 0).toLocaleString('vi-VN') %> món</small>
            </div>
            <em><%= formatMoney(product.total_revenue) %></em>
          </li>
        <% }) %>
        <% } else { %>
          <li>
            <span>-</span>
            <div>
              <strong>Chưa có dữ liệu</strong>
              <small>Chưa có đơn hoàn thành</small>
            </div>
            <em>0 đ</em>
          </li>
        <% } %>
      </ul>
    </section>

    <section class='dashboard-panel orders-panel'>
      <div class='panel-heading'>
        <h2>Đơn hàng gần đây</h2>
        <a href='/admin/orders'>Xem tất cả</a>
      </div>
      <div class='admin-table-wrap'>
        <table class='admin-table'>
          <thead>
            <tr>
              <th>Mã đơn</th>
              <th>Khách hàng</th>
              <th>Tổng tiền</th>
              <th>Trạng thái</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentOrderRows.length) { %>
            <% recentOrderRows.forEach(function(order) { %>
              <tr>
                <td><%= order.order_code || '#' + order.id %></td>
                <td><%= order.receiver_name || order.customer_name || 'Khách tại quán' %></td>
                <td><%= formatMoney(order.total_amount) %></td>
                <td><span class='status-pill'><%= statusMap[order.status] || order.status || '-' %></span></td>
              </tr>
            <% }) %>
            <% } else { %>
              <tr>
                <td colspan='4'>Chưa có đơn hàng.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>

    <section class='dashboard-panel quick-panel'>
      <div class='panel-heading'>
        <h2>Thao tác nhanh</h2>
      </div>
      <a href='/admin/products/create'>+ Thêm sản phẩm</a>
      <a href='/admin/orders'>+ Tạo đơn hàng</a>
      <a href='/admin/promotions/create'>+ Tạo khuyến mãi</a>
      <a href='/admin/statistics'>R Xem báo cáo</a>
    </section>
  </div>
</section>
