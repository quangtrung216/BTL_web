<% const promo = item || {}; %>
<%
  const toInputDate = function(value) {
    if (!value) return '';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return '';
    const pad = function(number) { return String(number).padStart(2, '0'); };
    return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
  };
  const currentType = promo.discount_type || 'percent';
  const currentActive = promo.is_active === undefined ? 1 : Number(promo.is_active);
%>

<section class='admin-promotion-editor'>
  <div class='admin-list-head'>
    <div>
      <h1>Tạo khuyến mãi</h1>
      <p>Thiết lập mã giảm giá mới, điều kiện áp dụng và khung thời gian sử dụng.</p>
    </div>
    <a class='admin-table-link' href='/admin/promotions'>Quay lại danh sách</a>
  </div>

  <form class='admin-product-form promotion-form' method='post' action='/admin/promotions/create'>
    <aside class='promotion-preview-card'>
      <span>SALE</span>
      <h2>Mã khuyến mãi mới</h2>
      <p>Mã sẽ được khách nhập ở giỏ hàng. Mã đang bật và còn hạn mới có thể áp dụng.</p>
      <dl>
        <div>
          <dt>Kiểu giảm</dt>
          <dd>% hoặc số tiền cố định</dd>
        </div>
        <div>
          <dt>Điều kiện</dt>
          <dd>Đơn tối thiểu và lượt dùng</dd>
        </div>
      </dl>
    </aside>

    <div class='admin-product-form-card'>
      <div class='admin-form-section'>
        <h2>Thông tin mã</h2>
        <div class='admin-form-grid'>
          <label>
            <span>Mã khuyến mãi</span>
            <input type='text' name='code' value='<%= promo.code || "" %>' placeholder='SUMMER15' required>
          </label>

          <label>
            <span>Tên chương trình</span>
            <input type='text' name='name' value='<%= promo.name || "" %>' placeholder='Ưu đãi mùa hè 15%' required>
          </label>

          <label>
            <span>Trạng thái</span>
            <select name='is_active'>
              <option value='1' <%= currentActive === 1 ? 'selected' : '' %>>Đang bật</option>
              <option value='0' <%= currentActive !== 1 ? 'selected' : '' %>>Tạm tắt</option>
            </select>
          </label>
        </div>
      </div>

      <div class='admin-form-section'>
        <h2>Giá trị ưu đãi</h2>
        <div class='admin-form-grid'>
          <label>
            <span>Kiểu giảm</span>
            <select name='discount_type'>
              <option value='percent' <%= currentType === 'percent' ? 'selected' : '' %>>Theo phần trăm</option>
              <option value='fixed' <%= currentType === 'fixed' ? 'selected' : '' %>>Số tiền cố định</option>
            </select>
          </label>

          <label>
            <span>Giá trị giảm</span>
            <input type='number' step='0.01' min='0' name='discount_value' value='<%= promo.discount_value || "" %>' placeholder='15' required>
          </label>

          <label>
            <span>Đơn tối thiểu</span>
            <input type='number' step='1000' min='0' name='min_order_value' value='<%= promo.min_order_value || 0 %>' placeholder='80000' required>
          </label>

          <label>
            <span>Giới hạn lượt dùng</span>
            <input type='number' min='0' name='usage_limit' value='<%= promo.usage_limit === null || promo.usage_limit === undefined ? "" : promo.usage_limit %>' placeholder='Để trống nếu không giới hạn'>
          </label>
        </div>
      </div>

      <div class='admin-form-section'>
        <h2>Thời gian áp dụng</h2>
        <div class='admin-form-grid'>
          <label>
            <span>Ngày bắt đầu</span>
            <input type='datetime-local' name='start_date' value='<%= toInputDate(promo.start_date) %>' required>
          </label>

          <label>
            <span>Ngày kết thúc</span>
            <input type='datetime-local' name='end_date' value='<%= toInputDate(promo.end_date) %>' required>
          </label>
        </div>
      </div>

      <div class='admin-product-form-actions'>
        <a class='admin-table-link' href='/admin/promotions'>Hủy</a>
        <button type='submit'>Tạo khuyến mãi</button>
      </div>
    </div>
  </form>
</section>
